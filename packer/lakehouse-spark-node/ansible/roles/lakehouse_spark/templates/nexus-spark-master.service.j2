[Unit]
Description=Nexus Apache Spark standalone Master (HA, ZooKeeper-elected)
Documentation=https://spark.apache.org/docs/latest/spark-standalone.html
After=network-online.target lakehouse-node-firstboot.service
Wants=network-online.target
Requires=lakehouse-node-firstboot.service
# Delivered DISABLED by the lakehouse_spark Packer role. Enabled on
# spark-master-1/2 only by role-overlay-spark-config.tf, which renders
# {{ lakehouse_spark_identity_dir }}/spark-cluster.env + $SPARK_HOME/conf/spark-env.sh
# (recoveryMode=ZOOKEEPER -> the zookeeper-1..3 ensemble) + spark-defaults.conf.
ConditionPathExists={{ lakehouse_spark_identity_dir }}/spark-cluster.env

[Service]
Type=simple
User={{ lakehouse_spark_user }}
Group={{ lakehouse_spark_group }}
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
Environment=SPARK_HOME={{ lakehouse_spark_home }}
Environment=SPARK_LOG_DIR={{ lakehouse_spark_log_dir }}
EnvironmentFile=-{{ lakehouse_spark_identity_dir }}/spark-cluster.env
ExecStart={{ lakehouse_spark_home }}/bin/spark-class org.apache.spark.deploy.master.Master --host ${SPARK_MASTER_HOST} --port 7077 --webui-port 8080
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
