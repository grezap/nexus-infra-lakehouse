[Unit]
Description=lakehouse-node firstboot (NIC discovery, hostname mapping, VMnet10 backplane, node-identity env)
After=systemd-networkd.service network-online.target
Wants=network-online.target
# No Before= for the role services -- firstboot does NOT enable any MinIO /
# Spark / Iceberg / PostgreSQL service (their config needs per-host data
# rendered by the Terraform role-overlays: MinIO server peer set, Spark
# master/worker join, Iceberg REST catalog config, PG streaming replication +
# keepalived VIP). The role-overlays enable exactly one role service per node
# post-apply.
ConditionPathExists=!/var/lib/lakehouse-node-firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lakehouse-node-firstboot.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
